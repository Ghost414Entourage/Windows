

https://support.microsoft.com/en-us/servicing/os/windows/docs/2026/09/verify-the-authenticity-of-a-windows-11-enterprise-evaluation-iso-file


----------------------------------------------------------------------------------------------------------------------------------------------------------------

cd "$env:USERPROFILE\Downloads"


Get-AuthenticodeSignature .\MediaCreationTool.exe | Format-List


Get-FileHash .\MediaCreationTool.exe -Algorithm SHA256


Get-AuthenticodeSignature .\MediaCreationTool.exe | Format-List Status, StatusMessage, SignerCertificate


Get-AuthenticodeSignature .\MediaCreationTool.exe | Format-List TimeStamperCertificate

(Get-CimInstance -ClassName SoftwareLicensingService).OA3xOriginalProductKey

slmgr /xpr

DISM /Online /Get-CurrentEdition


