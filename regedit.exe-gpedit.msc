Computer\HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\Privacy





Get-ChildItem -Path "HKLM:\SOFTWARE\Microsoft\PolicyManager\default\Privacy" -Recurse | Where-Object { $_.Property -contains "value" } | ForEach-Object {
    # Get the current value for context
    $currentVal = (Get-ItemProperty -Path $_.PSPath -Name "value" -ErrorAction SilentlyContinue).value
    
    # Show the current key path and value
    Write-Host "`n----------------------------------------" -ForegroundColor DarkGray
    Write-Host "Path: $($_.PSPath)" -ForegroundColor Cyan
    Write-Host "Current 'value': $currentVal" -ForegroundColor Yellow
    
    # Prompt for new value (press Enter without typing to skip)
    $userInput = Read-Host "Enter new value"
    
    if ($userInput -ne "") {
        Set-ItemProperty -Path $_.PSPath -Name "value" -Value ([int]$userInput)
        Write-Host "-> Updated successfully!" -ForegroundColor Green
    } else {
        Write-Host "-> Skipped." -ForegroundColor DarkYellow
    }
}



