Computer\HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\Privacy

------------------------------------------------------------------------------------------------------------------------

HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\Connectivity\AllowBluetooth  0

reg add "HKLM\SOFTWARE\Microsoft\PolicyManager\default\Connectivity\AllowBluetooth" /v "value" /t REG_DWORD /d 0 /f

------------------------------------------------------------------------------------------------------------------------

reg query "HKLM\SOFTWARE\Microsoft\PolicyManager\default\Privacy" /s

Get-ChildItem -Path "HKLM:\SOFTWARE\Microsoft\PolicyManager\default\Privacy" -Recurse | Get-ItemProperty

Get-ChildItem -Path "HKLM:\SOFTWARE\Microsoft\PolicyManager\default\Privacy" -Recurse | Where-Object { $_.Property -contains "value" } | ForEach-Object { Set-ItemProperty -Path $_.PSPath -Name "value" -Value 2 }

------------------------------------------------------------------------------------------------------------------------

# Enable Windows Firewall for all profiles

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $p="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; Set-ItemProperty $p -Name "EnableFirewall" -Value 1 -Type DWord }

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $p="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_"; if(Test-Path $p){Get-ItemProperty $p -Name "EnableFirewall" -EA SilentlyContinue}else{[PSCustomObject]@{Profile=$_;Status="Not Configured"}} }

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { [PSCustomObject]@{Profile=$_; Value=(Get-ItemProperty "HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_" -Name "EnableFirewall" -EA SilentlyContinue).EnableFirewall} }



# Default deny inbound

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { [PSCustomObject]@{Profile=$_; Value=(Get-ItemProperty "HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_" -Name "DefaultInboundAction" -EA SilentlyContinue).DefaultInboundAction} }

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $p="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; Set-ItemProperty $p -Name "DefaultInboundAction" -Value 1 -Type DWord }




# Enable logging

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { [PSCustomObject]@{Profile=$_; Value=(Get-ItemProperty "HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_\Logging" -Name "LogFilePath" -EA SilentlyContinue).LogFilePath} }

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $p="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; $lp="$p\Logging"; if(!(Test-Path $lp)){New-Item $lp -Force|Out-Null}; Set-ItemProperty $lp -Name "LogFilePath" -Value "%SystemRoot%\System32\LogFiles\Firewall\pfirewall.log" -Type String }




"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { [PSCustomObject]@{Profile=$_; Value=(Get-ItemProperty "HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_\Logging" -Name "LogFileSize" -EA SilentlyContinue).LogFileSize} }

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $lp="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_\Logging"; if(!(Test-Path $lp)){New-Item $lp -Force|Out-Null}; Set-ItemProperty $lp -Name "LogFileSize" -Value 16384 -Type DWord }



"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { [PSCustomObject]@{Profile=$_; Value=(Get-ItemProperty "HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_\Logging" -Name "LogDroppedPackets" -EA SilentlyContinue).LogDroppedPackets} }

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $lp="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_\Logging"; if(!(Test-Path $lp)){New-Item $lp -Force|Out-Null}; Set-ItemProperty $lp -Name "LogDroppedPackets" -Value 1 -Type DWord }



"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $lp="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_\Logging"; if(!(Test-Path $lp)){New-Item $lp -Force|Out-Null}; Set-ItemProperty $lp -Name "LogSuccessfulConnections" -Value 1 -Type DWord }

"DomainProfile", "PrivateProfile", "PublicProfile" | ForEach-Object { $lp="HKLM:\Software\Policies\Microsoft\WindowsFirewall\$_\Logging"; if(!(Test-Path $lp)){New-Item $lp -Force|Out-Null}; Set-ItemProperty $lp -Name "LogSuccessfulConnections" -Value 1 -Type DWord }



------------------------------------------------------------------------------------------------------------------------

# Configure Windows Defender settings

Get-ItemProperty "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection" -Name "DisableRealtimeMonitoring" -EA SilentlyContinue

$p = "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; Set-ItemProperty $p -Name "DisableRealtimeMonitoring" -Value 0 -Type DWord



Get-ItemProperty "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection" -Name "DisableBehaviorMonitoring" -EA SilentlyContinue

$p = "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; Set-ItemProperty $p -Name "DisableBehaviorMonitoring" -Value 0 -Type DWord



Get-ItemProperty "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection" -Name "DisableIOAVProtection" -EA SilentlyContinue

$p = "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; Set-ItemProperty $p -Name "DisableIOAVProtection" -Value 0 -Type DWord


Get-ItemProperty "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection" -Name "DisableOnAccessProtection" -EA SilentlyContinue

$p = "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; Set-ItemProperty $p -Name "DisableOnAccessProtection" -Value 0 -Type DWord


Get-ItemProperty "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection" -Name "DisableScanOnRealtimeEnable" -EA SilentlyContinue

$p = "HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"; if(!(Test-Path $p)){New-Item $p -Force|Out-Null}; Set-ItemProperty $p -Name "DisableScanOnRealtimeEnable" -Value 0 -Type DWord



