cd $env:USERPROFILE\Downloads


Expand-Archive -Path .\LGPO.zip -DestinationPath .\LGPO


New-Item -ItemType Directory -Force -Path "C:\Baseline\DefaultLocalGPO"


Get-ChildItem -Recurse -Filter "LGPO.exe" | ForEach-Object { & $_.FullName /b C:\Baseline\DefaultLocalGPO }


ls "C:\Baseline\DefaultLocalGPO"
  



