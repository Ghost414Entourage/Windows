cd "$env:USERPROFILE\Downloads"

CertUtil -generateSSTFromWU RootStore.sst

Get-ChildItem -Filter "RootStore.sst"

Get-ChildItem -Path Cert:\LocalMachine\Root | Select-Object Subject, Thumbprint, NotAfter

(Get-ChildItem -Path Cert:\LocalMachine\Root).Count

Import-Certificate -FilePath "C:\Users\computer\Downloads\RootStore.sst" -CertStoreLocation Cert:\LocalMachine\Root


************************************************************************************************************************************


Remove-Item -Path "$env:USERPROFILE\Downloads\*" -Recurse -Force

# 1. Download the Trusted Roots store
CertUtil -generateSSTFromWU RootStore.sst

# 2. Download the Untrusted/Disallowed store directly from Microsoft's CTL endpoint
Invoke-WebRequest -Uri "http://ctldl.windowsupdate.com/msdownload/update/v3/static/trustedr/en/disallowedcert.sst" -OutFile "disallowedcert.sst"


# Import trusted root certificates
Import-Certificate -FilePath "C:\Users\computer\Downloads\RootStore.sst" -CertStoreLocation Cert:\LocalMachine\Root

# Import untrusted/revoked certificates to enforce blocks
Import-Certificate -FilePath "C:\Users\computer\Downloads\disallowedcert.sst" -CertStoreLocation Cert:\LocalMachine\Disallowed

(Get-ChildItem -Path Cert:\LocalMachine\Disallowed).Count

************************************************************************************************************************************


Get-Childitem cert:\LocalMachine\root |format-list

Get-ChildItem cert:\LocalMachine\root|Where {$_.NotAfter -lt  (Get-Date).AddDays(60)}|select NotAfter, Subject

Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\SystemCertificates\AuthRoot' -Name DisableRootAutoUpdate

