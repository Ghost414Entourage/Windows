Get-Service -Name $servicesToDisable |
    Select Name, Status, StartType |
    Format-Table -AutoSize



---------------------------------------------------------------------------------------------------------------------------------------------------

Get-Service | Where-Object Status -eq 'Running' |
  Sort-Object DisplayName |
  Select-Object DisplayName, Name, StartType |
  Format-Table -AutoSize


---------------------------------------------------------------------------------------------------------------------------------------------------


$servicesToDisable = @('Fax','RemoteRegistry','SSDPSRV','WSearch','TlntSvr'); foreach ($svc in $servicesToDisable) { Try { Stop-Service -Name $svc -Force -ErrorAction Stop; Set-Service -Name $svc -StartupType Disabled; Write-Host "Disabled service: $svc" -ForegroundColor Green } Catch { Write-Warning "Could not disable ${svc}: $_" } }

