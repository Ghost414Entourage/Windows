    # Extract release info from plain-text node
    $releaseInfo = ($benchmark.'plain-text' | Where-Object { $_.id -eq 'release-info' }).'#text'
    
    [PSCustomObject]@{
        Technology   = $_.Directory.Name
        STIG_Title   = $benchmark.title
        Version      = $benchmark.version
        Release_Info = $releaseInfo
        FileName     = $_.Name
    }
} | Out-GridView
