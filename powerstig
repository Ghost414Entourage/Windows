# View available technologies and versions built into PowerSTIG
Get-Stig -ListAvailable


----------------------------------------------------------------------------------------------------------------------------------------------

$stigPath = Join-Path (Get-Module PowerSTIG -ListAvailable).ModuleBase "StigData\Archive"

Get-ChildItem -Path $stigPath -Filter "*.xml" -Recurse | ForEach-Object {
    [xml]$xml = Get-Content $_.FullName
    $benchmark = $xml.Benchmark
    
    # Extract release info from plain-text node
    $releaseInfo = ($benchmark.'plain-text' | Where-Object { $_.id -eq 'release-info' }).'#text'
    
    [PSCustomObject]@{
        Technology   = $_.Directory.Name
        STIG_Title   = $benchmark.title
        Version      = $benchmark.version
        Release_Info = $releaseInfo
        FileName     = $_.Name
    }
} | Out-GridView
----------------------------------------------------------------------------------------------------------------------------------------------

$ModulePath = (Get-Module -ListAvailable PowerSTIG).ModuleBase

Get-ChildItem -Path "$ModulePath\StigData\Processed" -Recurse -File | 
    Select-Object @{Name='Technology'; Expression={$_.Directory.Name}},
                  @{Name='Baseline File'; Expression={$_.Name}},
                  @{Name='STIG Release Date'; Expression={$_.LastWriteTime}} | 
    Out-GridView

