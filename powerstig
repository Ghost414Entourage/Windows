Get-ChildItem -Path "$((Get-Module PowerSTIG -ListAvailable | Select-Object -First 1).ModuleBase)\StigData\Archive\*\*.xml" -Recurse | ForEach-Object { $xml = [xml](Get-Content $_.FullName); [PSCustomObject]@{ FileName = $_.Name; BenchmarkID = $xml.Benchmark.id; Version = $xml.Benchmark.version; Release = ($xml.Benchmark.plain_text | Where-Object { $_.id -eq 'release-info' }).'#text'; BenchmarkDate = $xml.Benchmark.status.date } } | Format-Table -AutoSize

