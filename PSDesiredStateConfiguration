Invoke-DscResource -Name RegistryPolicyFile -ModuleName GPRegistryPolicyDsc -Method Set -Property @{Key='SOFTWARE\Policies\Microsoft\WindowsFirewall\PrivateProfile\Logging'; ValueName='LogFilePath'; ValueData=@('%SystemRoot%\System32\logfiles\firewall\privatefw.log'); ValueType='String'; TargetType='ComputerConfiguration'; Ensure='Present'}

# Configure Log File Size - 16384 KB
