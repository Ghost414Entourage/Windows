# Log Successful Connections
Invoke-DscResource -Name RegistryPolicyFile -ModuleName GPRegistryPolicyDsc -Method Set -Property @{Key='SOFTWARE\Policies\Microsoft\WindowsFirewall\PrivateProfile\Logging'; ValueName='LogSuccessfulConnections'; ValueData=@('1'); ValueType='Dword'; TargetType='ComputerConfiguration'; Ensure='Present'}

# Apply All Group Policies
