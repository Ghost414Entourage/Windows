# List locally installed versions and paths
Get-Module -ListAvailable -Name PSDesiredStateConfiguration | Select-Object Name, Version, Path

# List all published stable versions
Find-Module -Name PSDesiredStateConfiguration -AllVersions | Select-Object Name, Version, PublishedDate

# Find the latest stable version
Find-Module -Name PSDesiredStateConfiguration | Select-Object Name, Version, PublishedDate

# List all versions, including prerelease versions
Find-Module -Name PSDesiredStateConfiguration -AllVersions -AllowPrerelease | Select-Object Name, Version, PublishedDate

# Check module dependencies
Find-Module -Name PSDesiredStateConfiguration | Select-Object -ExpandProperty Dependencies

# Install the latest stable version for all users
Install-Module -Name PSDesiredStateConfiguration -Scope AllUsers

# Install a specific module version for all users
Install-Module -Name PSDesiredStateConfiguration -RequiredVersion 2.0.8 -Scope AllUsers

# Install a specific prerelease version
Install-Module -Name PSDesiredStateConfiguration -RequiredVersion '<PrereleaseVersion>' -AllowPrerelease -Scope AllUsers

# Verify locally installed versions and paths
Get-Module -ListAvailable -Name PSDesiredStateConfiguration | Select-Object Name, Version, Path

# Import a specific module version
Import-Module -Name PSDesiredStateConfiguration -RequiredVersion 2.0.8

# Verify the currently loaded module version
Get-Module -Name PSDesiredStateConfiguration | Select-Object Name, Version, Path

# Discover available DSC resources
Get-DscResource


