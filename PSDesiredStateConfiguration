Private Profile


# Enable Firewall
Invoke-DscResource -Name RegistryPolicyFile -ModuleName GPRegistryPolicyDsc -Method Set -Property @{Key='SOFTWARE\Policies\Microsoft\WindowsFirewall\PrivateProfile'; ValueName='EnableFirewall'; ValueData=@('1'); ValueType='Dword'; TargetType='ComputerConfiguration'; Ensure='Present'}

# Inbound Connections - Block
Invoke-DscResource -Name RegistryPolicyFile -ModuleName GPRegistryPolicyDsc -Method Set -Property @{Key='SOFTWARE\Policies\Microsoft\WindowsFirewall\PrivateProfile'; ValueName='DefaultInboundAction'; ValueData=@('1'); ValueType='Dword'; TargetType='ComputerConfiguration'; Ensure='Present'}

