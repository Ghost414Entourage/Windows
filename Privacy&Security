uterConfiguration -Ensure Present -ErrorAction Stop }; gpupdate.exe /target:computer /force; if ($LASTEXITCODE -ne 0) { throw "Computer policy refresh failed with exit code $LASTEXITCODE." } } finally { Set-ExecutionPolicy -Scope Process -ExecutionPolicy $old -Force }; $mismatches = foreach ($entry in $entries) { $path = "HKLM:\$($entry.Key)"; $key = Get-Item -LiteralPath $path -ErrorAction SilentlyContinue; if ($null -eq $key -or $key.GetValueNames() -notcontains $entry.ValueName -or $key.GetValueKind($entry.ValueName) -ne $entry.ValueType -or ([string]$key.GetValue($entry.ValueName)) -cne $entry.Data) { "$path\$($entry.ValueName) should be $($entry.ValueType) $($entry.Data)" } }; if ($mismatches) { $mismatches | ForEach-Object { Write-Warning $_ }; throw 'One or more registry values did not verify.' }; "Verified all $($entries.Count) registry values." }




