Open gpedit.msc (Local Group Policy Editor) or your domain's Group Policy Management Editor.
Navigate to: Computer Configuration > Administrative Templates > Windows Components > Windows PowerShell.
Enable the setting "Turn on PowerShell Script Block Logging.



$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging"
$RegistryName = "EnableScriptBlockLogging"
$RegistryValue = 1

if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

Set-ItemProperty -Path $RegistryPath -Name $RegistryName -Value $RegistryValue -Force


