2.2.2 Ensure 'Access this computer from the network' is set to 'Administrators, Remote Desktop Users'

gpedit.msc

Navigate to Computer Configuration > Windows Settings > Security Settings > Local Policies > User Rights Assignment
Double-click 'Access this computer from the network'
Check if the access is allowed only to Administrators, Remote Desktop Users. Remove other Users and Groups from the list.


Computer\HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\UserRights\AccessFromNetwork


reg query "HKLM\SOFTWARE\Microsoft\PolicyManager\default\UserRights\AccessFromNetwork"


Get-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\PolicyManager\default\UserRights\AccessFromNetwork" -ErrorAction SilentlyContinue


$inf="$env:TEMP\user_rights.inf"; secedit /export /areas user_rights /cfg $inf /quiet | Out-Null; Get-Content $inf | Select-String "SeNetworkLogonRight"; Remove-Item $inf


*S-1-1-0 $\rightarrow$ Everyone
*S-1-5-32-544 $\rightarrow$ Administrators
*S-1-5-32-545 $\rightarrow$ Users
*S-1-5-32-551 $\rightarrow$ Backup Operators


$inf="$env:TEMP\apply_policy.inf"; "[Unicode]`nUnicode=yes`n[Version]`nsignature=`"`$CHICAGO$`"`n[Privilege Rights]`nSeNetworkLogonRight = *S-1-5-32-544,*S-1-5-32-555" | Set-Content $inf; secedit /configure /db "$env:TEMP\sec.sdb" /cfg $inf /quiet; Remove-Item $inf, "$env:TEMP\sec.sdb" -ErrorAction SilentlyContinue

$inf="$env:TEMP\apply_policy.inf"; "[Unicode]`nUnicode=yes`n[Version]`nsignature=`"`$CHICAGO$`"`n[Privilege Rights]`nSeNetworkLogonRight = *S-1-5-32-544" | Set-Content $inf; secedit /configure /db "$env:TEMP\sec.sdb" /cfg $inf /quiet; Remove-Item $inf, "$env:TEMP\sec.sdb" -ErrorAction SilentlyContinue

$inf="$env:TEMP\apply_policy.inf"; "[Unicode]`nUnicode=yes`n[Version]`nsignature=`"`$CHICAGO$`"`n[Privilege Rights]`nSeNetworkLogonRight =" | Set-Content $inf; secedit /configure /db "$env:TEMP\sec.sdb" /cfg $inf /quiet; Remove-Item $inf, "$env:TEMP\sec.sdb" -ErrorAction SilentlyContinue


$path = "HKLM:\SOFTWARE\Microsoft\PolicyManager\current\device\UserRights"; if (-not (Test-Path $path)) { New-Item -Path $path -Force | Out-Null }; Set-ItemProperty -Path $path -Name "AccessFromNetwork" -Value "*S-1-5-32-544"

$path = "HKLM:\SOFTWARE\Microsoft\PolicyManager\current\device\UserRights"; if (-not (Test-Path $path)) { New-Item -Path $path -Force | Out-Null }; Set-ItemProperty -Path $path -Name "AccessFromNetwork" -Value ""


"\Registry\Machine\SOFTWARE\Microsoft\PolicyManager\current\device\UserRights`nAccessFromNetwork = *S-1-5-32-544" | Out-File "$env:TEMP\r.txt" -Encoding unicode; regini "$env:TEMP\r.txt"; Remove-Item "$env:TEMP\r.txt"

"\Registry\Machine\SOFTWARE\Microsoft\PolicyManager\current\device\UserRights`nAccessFromNetwork = " | Out-File "$env:TEMP\r.txt" -Encoding unicode; regini "$env:TEMP\r.txt"; Remove-Item "$env:TEMP\r.txt"


reg add "HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\UserRights" /v AccessFromNetwork /t REG_SZ /d "*S-1-5-32-544" /f

