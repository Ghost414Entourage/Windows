# Path to the Machine Policy file read by gpedit.msc
$RegPolPath = "$env:windir\System32\GroupPolicy\Machine\registry.pol"

# Write the Bluetooth restriction directly into registry.pol
Set-PolicyFileEntry -Path $RegPolPath `
                    -Key "Software\Policies\Microsoft\Windows\Bluetooth" `
                    -ValueName "AllowBluetooth" `
                    -Type DWord `
                    -Data 0

# Refresh Group Policy to push the registry.pol change into the live Registry & Settings UI
gpupdate /force


