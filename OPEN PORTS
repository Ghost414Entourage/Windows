Get-NetTCPConnection | Where-Object { 
    $_.State -eq 'Established' -and 
    $_.RemoteAddress -ne '127.0.0.1' -and 
    $_.RemoteAddress -ne '::1'
} | ForEach-Object {
    $procName = (Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue).ProcessName
    $isMalicious = $false

    foreach ($MaliciousIP in $MaliciousIPs) {
        if ($_.RemoteAddress -like "$($MaliciousIP.Split('/')[0])*") {
            $isMalicious = $true
            break
        }
    }

    # Attach ProcessName and SuspiciousReason properties to the object
    $_ | Add-Member -MemberType NoteProperty -Name 'ProcessName' -Value $procName -Force
    $_ | Add-Member -MemberType NoteProperty -Name 'SuspiciousReason' -Value ($(if ($isMalicious) { "Matches known malicious IP range" } else { "Clean" })) -Force

    # Output object downstream
    $_
} | Select-Object ProcessName, LocalAddress, LocalPort, RemoteAddress, RemotePort, State, SuspiciousReason | Format-Table -AutoSize -Wrap


